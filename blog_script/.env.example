# Copy to .env, set every REQUIRED value, then run ./deploy.sh.
# Do not commit .env. This bundle's .gitignore excludes it.

# REQUIRED: Hetzner Cloud project API token (read/write).
HETZNER_TOKEN=
# REQUIRED: publicly resolvable FQDN. Create an A/AAAA record pointing here after
# deploy prints the server address; deploy waits for DNS before starting Caddy.
DOMAIN=blog.example.com
# REQUIRED: address used for Let's Encrypt expiry notices.
EMAIL=admin@example.com

# Tailscale is the supported default. The auth key needs tag:ghost (recommended)
# and should be reusable only if you deliberately want replacement servers to join.
TUNNEL_PROVIDER=tailscale
TUNNEL_AUTH_KEY=
TAILSCALE_HOSTNAME=ghost-blog

# Optional Hetzner placement / sizing. CX22 = 2 vCPU, 4 GB RAM, 40 GB disk.
HETZNER_SERVER_TYPE=cx22
HETZNER_LOCATION=fsn1
HETZNER_IMAGE=ubuntu-24.04
HETZNER_SERVER_NAME=ghost-blog

# Optional: existing local SSH public key used solely as an emergency bootstrap key.
# Public inbound SSH remains blocked at both Hetzner and host firewall layers.
# SSH_PUBLIC_KEY_FILE=$HOME/.ssh/id_ed25519.pub

# Required only for off-host backups. A restic repository URL and password.
# Example repository: s3:s3.amazonaws.com/bucket/ghost
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Pin images deliberately; update after testing release notes.
GHOST_IMAGE=ghost:5.130.1-alpine
MYSQL_IMAGE=mysql:8.4.6
CADDY_IMAGE=caddy:2.10.2-alpine
